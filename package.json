{
  "name": "morning-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone local read-model dashboard unifying beads across all ojfbot projects into Overnight / Daily-pickup / Available lanes.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @cockpit/server dev",
    "dev:renderer": "pnpm --filter @cockpit/renderer dev",
    "watch:poll": "pnpm --filter @cockpit/watch poll",
    "watch:verify-sources": "pnpm --filter @cockpit/watch verify-sources",
    "watch:opml": "pnpm --filter @cockpit/watch opml"
  }
}
